# Database Configuration (Docker network URL)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/ai_voice

# Database Configuration for local development (outside Docker)
LOCAL_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ai_voice

# Security
JWT_SECRET=your_jwt_secret_key_here

# External APIs (For subsequent phases)
GEMINI_API_KEY=your_gemini_api_key_here
ASSEMBLYAI_API_KEY=your_assemblyai_api_key_here

# Frontend / CORS
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
VITE_API_BASE_URL=http://localhost:8000
